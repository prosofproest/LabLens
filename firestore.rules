rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth UID
    //   - name: string (required, 2-80 chars) - User's full name
    //   - email: string (required, immutable) - User's email
    //   - role: string (required, 'user' or 'admin', immutable by user)
    //   - department: string (required, approved list) - College department
    //   - createdAt: timestamp (required, immutable) - Profile creation time
    //
    // Collection: reports
    // Document ID: {reportId} (auto-generated)
    // Fields:
    //   - equipmentName: string (required, 2-100 chars) - Name of faulty equipment
    //   - assetId: string (required, 2-50 chars) - College asset tag / hardware ID
    //   - labName: string (required, 2-100 chars) - Laboratory name/room
    //   - description: string (required, 5-2000 chars) - Fault symptom details
    //   - status: string (required, 'Reported' on create) - Lifecycle status
    //   - priority: string (required, 'Low'|'Medium'|'High'|'Critical') - Triage urgency
    //   - createdAt: timestamp (required, immutable) - Submission timestamp
    //   - updatedAt: timestamp (required) - Last modified timestamp
    //   - reportedBy: map (required) - Submitter identity details
    //     - uid: string (required, matches request.auth.uid)
    //     - name: string (required, 2-100 chars)
    //     - email: string (required, 3-100 chars)
    //     - department: string (optional, <= 100 chars)
    //   - imageUrl: string or null (max 2048 chars) - Cloudinary image URL
    //   - imagePublicId: string or null (max 255 chars) - Cloudinary public ID
    //   - aiAnalysis: null or map (AI triage analysis)
    //   - assignedTechnician: null on creation (assigned by admin)
    //   - assignedAt: null on creation (timestamp when technician assigned)
    //   - adminNotes: null on creation (administrative remarks)
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidDepartment(dept) {
      return dept in [
        'Computer Science & Engineering',
        'Information Technology',
        'Electronics & Communication Engineering',
        'Electrical & Electronics Engineering',
        'Mechanical Engineering',
        'Civil Engineering',
        'General Sciences & Humanities'
      ];
    }

    function isValidStatus(status) {
      return status in ['Reported', 'In-Review', 'Assigned', 'In-Progress', 'Resolved', 'Cancelled'];
    }

    function isValidPriority(priority) {
      return priority in ['Low', 'Medium', 'High', 'Critical'];
    }

    function isValidAiAnalysis(ai) {
      return ai is map
        && ai.keys().hasAll([
          'isAiGenerated', 'status', 'suggestedCategory', 'suggestedPriority',
          'executiveSummary', 'possibleRootCause', 'recommendedAction', 'analyzedAt'
        ])
        && ai.keys().hasOnly([
          'isAiGenerated', 'status', 'suggestedCategory', 'suggestedPriority',
          'executiveSummary', 'possibleRootCause', 'recommendedAction', 'analyzedAt'
        ])
        && ai.isAiGenerated is bool
        && ai.status in ['success', 'unavailable', 'skipped']
        && ai.suggestedCategory in ['Hardware', 'Software', 'Network', 'Power/Electrical', 'Peripheral', 'Other']
        && isValidPriority(ai.suggestedPriority)
        && ai.executiveSummary is string && ai.executiveSummary.size() <= 1000
        && ai.possibleRootCause is string && ai.possibleRootCause.size() <= 1000
        && ai.recommendedAction is string && ai.recommendedAction.size() <= 1000
        && ai.analyzedAt is string;
    }

    function isValidReporter(reporter) {
      return reporter is map
        && reporter.keys().hasAll(['uid', 'name', 'email'])
        && reporter.keys().hasOnly(['uid', 'name', 'email', 'department'])
        && reporter.uid is string && reporter.uid == request.auth.uid
        && reporter.name is string && reporter.name.size() >= 2 && reporter.name.size() <= 100
        && reporter.email is string && reporter.email.size() >= 3 && reporter.email.size() <= 100
        && (!('department' in reporter) || (reporter.department is string && reporter.department.size() <= 100));
    }

    function isValidReportCreate(data) {
      return data.keys().hasAll([
          'equipmentName', 'assetId', 'labName', 'description', 'status',
          'priority', 'createdAt', 'updatedAt', 'reportedBy', 'imageUrl',
          'imagePublicId', 'aiAnalysis', 'assignedTechnician', 'assignedAt', 'adminNotes'
        ])
        && data.keys().hasOnly([
          'equipmentName', 'assetId', 'labName', 'description', 'status',
          'priority', 'createdAt', 'updatedAt', 'reportedBy', 'imageUrl',
          'imagePublicId', 'aiAnalysis', 'assignedTechnician', 'assignedAt', 'adminNotes'
        ])
        && data.equipmentName is string && data.equipmentName.size() >= 2 && data.equipmentName.size() <= 100
        && data.assetId is string && data.assetId.size() >= 2 && data.assetId.size() <= 50
        && data.labName is string && data.labName.size() >= 2 && data.labName.size() <= 100
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 2000
        && data.status == 'Reported'
        && isValidPriority(data.priority)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidReporter(data.reportedBy)
        && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (data.imagePublicId == null || (data.imagePublicId is string && data.imagePublicId.size() <= 255))
        && (data.aiAnalysis == null || isValidAiAnalysis(data.aiAnalysis))
        && data.assignedTechnician == null
        && data.assignedAt == null
        && data.adminNotes == null;
    }

    function isValidAdminReportUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'priority', 'assignedTechnician', 'assignedAt', 'adminNotes', 'updatedAt'
        ])
        && isValidStatus(request.resource.data.status)
        && isValidPriority(request.resource.data.priority)
        && (request.resource.data.assignedTechnician == null || (request.resource.data.assignedTechnician is string && request.resource.data.assignedTechnician.size() <= 100))
        && (request.resource.data.assignedAt == null || request.resource.data.assignedAt is string || request.resource.data.assignedAt is timestamp)
        && (request.resource.data.adminNotes == null || (request.resource.data.adminNotes is string && request.resource.data.adminNotes.size() <= 1000))
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.equipmentName == resource.data.equipmentName
        && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.labName == resource.data.labName
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.imagePublicId == resource.data.imagePublicId
        && request.resource.data.aiAnalysis == resource.data.aiAnalysis;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // 1. Read: User can read their own profile; Admins can read any profile
      allow read: if isOwner(userId) || isAdmin();

      // 2. Create (Registration): Strict type and field validation
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && isValidDepartment(request.resource.data.department)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'department', 'createdAt']);

      // 3. Update: Strict field limitation for normal users
      allow update: if isAuthenticated() && (
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'department'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
          && isValidDepartment(request.resource.data.department)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || isAdmin()
      );

      // 4. Delete: Admins only
      allow delete: if isAdmin();
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      // 1. Read: Any authenticated user can read their own reports; Admins can read any report
      allow read: if isAuthenticated() && (
        resource.data.reportedBy.uid == request.auth.uid || isAdmin()
      );

      // 2. Create: Authenticated users can create reports with strict schema validation
      allow create: if isAuthenticated()
        && request.resource.data.reportedBy.uid == request.auth.uid
        && isValidReportCreate(request.resource.data);

      // 3. Update: Only admins can update reports with validated administrative fields
      allow update: if isValidAdminReportUpdate();

      // 4. Delete: Only admins can delete reports
      allow delete: if isAdmin();
    }
  }
}
