# ==============================================================================
# LabLens AI — Environment Variables Canonical Template (.env.example)
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# IMPORTANT:
# - Fill in your actual credentials in .env.local.
# - Never commit .env.local to version control (it is excluded by .gitignore).
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser bundle.
# - Variables WITHOUT NEXT_PUBLIC_ are strictly SERVER-ONLY secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Browser Accessible)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Cloudinary Media Storage Configuration (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard -> Programmable Media -> API Keys
# NOTE: These MUST NOT have a NEXT_PUBLIC_ prefix. They are used exclusively
# by server-side API Route Handlers (/api/upload) to sign and upload media assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 3. Groq AI Configuration (SERVER-ONLY SECRET — Production Active)
# ------------------------------------------------------------------------------
# Obtain from Groq Console -> API Keys (https://console.groq.com)
# Used for equipment fault triage, priority scoring & floating chatbot.
# DO NOT expose with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional: Groq inference model ID.
# Allowed models: openai/gpt-oss-20b, qwen/qwen3.8-27b
# Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 4. Production Security & Allowed Guest Origins
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed origins for unauthenticated guest chatbot access.
# Required in production to prevent cross-site origin abuse.
# Example: https://lablens.ac.in,https://lablens-ai.vercel.app
APP_TRUSTED_ORIGINS=

# The public canonical URL of the application.
# Example: https://lablens.ac.in
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 5. Distributed Serverless Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
# Required in production to prevent quota bypass across serverless Lambda instances.
# Obtain from Upstash Console -> Redis (https://console.upstash.com)
# Server-only secrets — DO NOT prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=



